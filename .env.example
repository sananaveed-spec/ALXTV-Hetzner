# Kiosk auth (required for password in normal browsers)
KIOSK_VIEW_PASSWORD=
# Long random string for TelemetryTV — openssl rand -hex 32
KIOSK_EMBED_KEY=
# Optional separate signing secret (defaults to KIOSK_VIEW_PASSWORD)
# KIOSK_AUTH_SECRET=

# --- Clockify (left 70% panel — built into ALX TV) ---
CLOCKIFY_API_KEY=your_clockify_api_key_here
CLOCKIFY_WORKSPACE_ID=your_workspace_id_here


# --- Google Sheets (right 30% panel — built into ALX TV) ---
# https://docs.google.com/spreadsheets/d/<GOOGLE_SPREADSHEET_ID>/edit
GOOGLE_SPREADSHEET_ID=1QSuAqkTAF3Dmn4DmWwhyesfzVgBKpBOJI6EwhwfAi4c

# --- Google auth (use ONE of the following) ---

# Recommended for Vercel / CI: paste the full service account JSON as a single line.
# In Google Cloud: APIs & Services → Enable "Google Sheets API" →
# IAM → Service Accounts → create key (JSON). Share your spreadsheet with the
# service account email (Viewer is enough).
GOOGLE_SERVICE_ACCOUNT_JSON=

# Local dev alternative: absolute path to the same JSON file on disk.



# Optional — Phase 2: one tab slice (A1 notation). Tab names with spaces need single quotes.
# GOOGLE_SHEET_RANGE='My Tab'!A1:Z200

# Engineer load tab (home /): tab name must match the sheet tab exactly.
# Each lead: 3 sheet columns — row 1 name, row 2 labels (matched to roles), row 3+ data until a blank row.
# Row 2 in each 3-column block: labels are matched to Project Name / Stage / PRIORITY (UI headers are fixed).
# The next lead starts at the next column where row 1 has any text (e.g. T:U:V, not only A:C, D:F, …).
# GOOGLE_ENGINEER_LOAD_TAB=ENGINEER LOAD
# Milliseconds per lead on the carousel when multiple leads exist (default 30000, min 2000, max 120000).
# GOOGLE_ENGINEER_SLIDE_MS=30000

# Project Details table (below engineer load): tab PROJECTS, rows from C14 (Name), E–G (Engineer, Status, Invoiced).
# GOOGLE_PROJECTS_TAB=PROJECTS

# Today TO DO LIST table: tab Today TO DO LIST, columns Reminder, Reminder Date, Project Name.
# Only rows whose Reminder Date matches today (in GOOGLE_SHEET_TIMEZONE) are shown; 10 per page, 10s per page.
# GOOGLE_TODAY_TODO_TAB=Today TO DO LIST
# GOOGLE_SHEET_TIMEZONE=Asia/Karachi
# GOOGLE_TODAY_TODO_SLIDE_MS=10000
